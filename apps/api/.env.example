# Copie este arquivo para ".env" (na mesma pasta) e preencha.
# O .env NUNCA vai para o git. Este .env.example vai, e não pode ter senhas.

# Porta em que a API roda no seu computador.
PORT=3333

# Endereços dos dois sites (pesquisa e gestão), separados por vírgula.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Endereço do banco no Supabase (Connect > Session pooler). É o MESMO para as duas.
# Pedir à Rafaela por mensagem privada. Nunca colar no git nem no chat.
DATABASE_URL=

# Segredo que assina o login (mínimo 32 caracteres). OBRIGATÓRIO: sem ele a API não liga.
# Para gerar um, rode no terminal:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# e cole o resultado aqui. Cada uma pode ter o seu. Nunca colar no git nem no chat.
JWT_SECRET=

# Endereço do site da pesquisa. É o link que vai dentro do QR Code de cada setor.
# No computador: http://localhost:5173. Depois de publicar, o endereço público do site.
SURVEY_SITE_URL=http://localhost:5173

# Senha dos usuários de exemplo criados pelo npm run db:seed (pelo menos 8 caracteres).
# Combinar entre as duas por mensagem privada. Nunca colar no git.
SEED_PASSWORD=
