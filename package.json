{
  "name": "sistema-avaliacoes-hospitalar",
  "private": true,
  "description": "Sistema de avaliação anônima do paciente: API, site da pesquisa e site de gestão",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace api",
    "test:api": "npm run test --workspace api",
    "dev:pesquisa": "npm run dev --workspace pesquisa",
    "dev:gestao": "npm run dev --workspace gestao",
    "db:migrate": "npm run db:migrate --workspace api",
    "db:seed": "npm run db:seed --workspace api"
  }
}
